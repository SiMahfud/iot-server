# ============================================================
# IoT Gateway Server - Git Ignore
# ============================================================

# Dependencies
node_modules/

# Production / Local Database (SQLite WAL Mode)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local Runtime Configuration & State
# Gunakan config.example.json dan schedules.example.json sebagai template
config.json
schedules.json
state.json

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pm2.log

# Firmware Binaries (OTA Updates)
firmwares/*.bin
!firmwares/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary / Scratch Files
tmp/
temp/
scratch/
